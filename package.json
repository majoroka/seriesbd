{
  "name": "stream-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cron:deploy": "npx wrangler deploy --config workers/heartbeat-cron/wrangler.toml",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "verify:release": "npm run test:run && npm run build",
    "bundle:audit": "sh scripts/create-audit-bundle.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.1.0",
    "@types/node": "^20.19.17",
    "jsdom": "^24.1.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "chart.js": "^4.4.2",
    "dexie": "^4.0.4"
  },
  "overrides": {
    "ajv": {
      "fast-uri": "3.1.8"
    },
    "filelist": {
      "minimatch": {
        "brace-expansion": "2.1.7"
      }
    },
    "glob": {
      "minimatch": {
        "brace-expansion": "5.0.12"
      }
    },
    "postcss": {
      "source-map-js": "1.2.2"
    }
  }
}
